{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": { "includes": ["**", "!**/*.json", "!**/*.yml", "!**/*.yaml", "!**/*.md"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "arrowParentheses": "asNeeded" } },
  "linter": {
    "rules": { "preset": "recommended", "suspicious": { "noExplicitAny": "off", "noEmptyBlockStatements": "off" } }
  }
}
