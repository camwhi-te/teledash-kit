# bun test loads this file; CI sets the same variables directly. Dev-only credentials.
# Replace "service" with the daemon's name: its own <name>_test database and the teledash_test vhost.
TEST_DATABASE_URL=postgres://service:service-dev@localhost:5433/service_test
TEST_AMQP_URL=amqp://service:service-dev@localhost:5673/teledash_test
TEST_DECLARE_EXCHANGES=true
